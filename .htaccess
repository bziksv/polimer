<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On

# ===== ИСКЛЮЧЕНИЯ ДЛЯ ФАЙЛОВ ОПИСАНИЙ (НЕ ПРИМЕНЯТЬ РЕДИРЕКТЫ) =====
RewriteRule ^(opisanie|opisanie-2|opisanie-3|opisanie-4|opisanie-5)\.html$ - [L]

# Убрать www → https; для 1C оставляем http (как в исключении HTTPS ниже)
RewriteCond %{HTTP_HOST} ^www.polimer-vrn\.ru$ [NC]
RewriteCond %{REQUEST_URI} !^/bitrix/admin/1c_exchange.php
RewriteRule ^(.*)$ https://polimer-vrn.ru/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www.polimer-vrn\.ru$ [NC]
RewriteRule ^(.*)$ http://polimer-vrn.ru/$1 [R=301,L]
# Убрать /index.php|/index.html|/index.htm → / (только абсолютный URL, иначе Apache подставит DocumentRoot)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(php|html|htm)[\s?] [NC]
RewriteRule ^index\.(php|html|htm)$ / [R=301,L]
# Убрать .../index.html|/index.htm в подкаталогах
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.+/index\.html?\ HTTP/ [NC]
RewriteRule ^(.+/)?index\.html?$ /$1 [R=301,L]
# Убрать .../index.php в подкаталогах
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.+/index\.php[\s?] [NC]
RewriteRule ^(.+/)?index\.php$ /$1 [R=301,L]
#убрать //
RewriteCond %{REQUEST_URI} ^(.*)/{2,}(.*)$
RewriteRule (.*) %1/%2 [R=301,L]
# убрать окончание html (ЗАКОММЕНТИРОВАНО, НО ЕСЛИ РАСКОММЕНТИРУЕТЕ - ИСКЛЮЧЕНИЕ УЖЕ РАБОТАЕТ)
# RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html [NC]
# RewriteCond %{REQUEST_URI} !^/(opisanie|opisanie-2|opisanie-3|opisanie-4|opisanie-5)\.html$ [NC]
# RewriteRule ^ /%1/ [R=301,L]
# убрать окончание htm (с исключением для описаний)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.htm [NC]
RewriteCond %{REQUEST_URI} !^/(opisanie|opisanie-2|opisanie-3|opisanie-4|opisanie-5)\.html$ [NC]
RewriteRule ^ /%1/ [R=301,L]
# убрать idc=4&marea=6
RewriteCond %{QUERY_STRING} ^idc=4&marea=6$ [NC]
RewriteRule ^index\.php$ /? [R=301,L]

RewriteEngine On
RewriteCond %{HTTPS} =off
RewriteCond %{REQUEST_URI} !^/bitrix/admin/1c_exchange.php
#RewriteCond %{REQUEST_URI} !^/bitrix/services/yandex.market/trading/marketplace/s1
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [QSA,R=301,L]

#убираем двойной слеш
RewriteCond %{THE_REQUEST} //
# Проверяем, повторяется ли слеш (//) более двух раз.
RewriteRule .* /$0 [R=301,L]
# Исключаем все лишние слеши.

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME} [\xC2-\xDF][\x80-\xBF] [OR]
RewriteCond %{REQUEST_FILENAME} \xE0[\xA0-\xBF][\x80-\xBF] [OR]
RewriteCond %{REQUEST_FILENAME} [\xE1-\xEC\xEE\xEF][\x80-\xBF]{2} [OR]
RewriteCond %{REQUEST_FILENAME} \xED[\x80-\x9F][\x80-\xBF] [OR]
RewriteCond %{REQUEST_FILENAME} \xF0[\x90-\xBF][\x80-\xBF]{2} [OR]
RewriteCond %{REQUEST_FILENAME} [\xF1-\xF3][\x80-\xBF]{3} [OR]
RewriteCond %{REQUEST_FILENAME} \xF4[\x80-\x8F][\x80-\xBF]{2}
RewriteCond %{REQUEST_FILENAME} !/bitrix/virtual_file_system.php$
RewriteRule ^(.*)$ /bitrix/virtual_file_system.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.*/[^/\.]+)$
  RewriteCond %{REQUEST_URI} !^/bitrix/services/yandex.market/trading/marketplace/s1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
  RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
  RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresByType image/jpeg "access plus 3 day"
  ExpiresByType image/gif "access plus 3 day"
  ExpiresByType image/png "access plus 3 day"
  ExpiresByType text/css "access plus 3 day"
  ExpiresByType application/javascript "access plus 3 day"
</IfModule>